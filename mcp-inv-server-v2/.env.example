# MCP Server Configuration
INV_MCP_HOST=0.0.0.0
INV_MCP_PORT=8080
INV_MCP_DEBUG=false

# Token Authentication Configuration
INV_MCP_JWT_SECRET=your-secret-key-change-in-production-min-32-bytes
INV_MCP_JWT_ALGORITHM=HS256
INV_MCP_ACCESS_TOKEN_EXPIRE_MINUTES=30
INV_MCP_REFRESH_TOKEN_EXPIRE_DAYS=7

# Token Configuration (static token mode)
# Format: client_id:secret:role (multiple tokens separated by comma)
INV_MCP_STATIC_TOKENS=client1:secret1:admin,client2:secret2:user

# OAuth2 Configuration (optional)
INV_MCP_OAUTH_ENABLED=false
INV_MCP_OAUTH_ISSUER=
INV_MCP_OAUTH_CLIENT_ID=
INV_MCP_OAUTH_CLIENT_SECRET=

# Database Configuration
INV_MCP_DB_HOST=your-db-host
INV_MCP_DB_PORT=3306
INV_MCP_DB_NAME=your_db_name
INV_MCP_DB_USER=your_readonly_user
INV_MCP_DB_PASSWORD=your_password

# Logging Configuration
INV_MCP_LOG_LEVEL=INFO
INV_MCP_LOG_FILE=logs/inv_mcp.log
