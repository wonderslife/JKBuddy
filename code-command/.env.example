# Code Command Configuration
# Copy this file to .env and customize

# API Authentication
# Set a strong random key for production
CODE_API_KEY=your-secret-api-key-here

# Work Directory
# Where session files and user uploads are stored
CODE_WORK_DIR=/tmp/code_command

# Shared Assets Path (optional)
# Path to icons, templates, and helper utilities
# SHARED_ASSETS_PATH=/path/to/shared_assets

# Execution Settings
CODE_EXEC_TIMEOUT=120          # Max execution time in seconds
SESSION_MAX_AGE_HOURS=24       # Auto-cleanup sessions older than this
CLEANUP_INTERVAL_MINUTES=60    # How often to run cleanup

# Resource Limits
CPU_LIMIT=0.5                  # CPU cores (0.5 = half a core)
WORKSPACE_SIZE_LIMIT=104857600 # 100MB max workspace size per session

# File Size Limits
MAX_UPLOAD_SIZE=52428800       # 50MB max upload

# CORS Settings
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3080,http://localhost:3000

# Docker Settings
SANDBOX_IMAGE=code-sandbox:latest

# LibreChat Compatibility
# These are the env vars LibreChat expects:
# LIBRECHAT_CODE_BASEURL=http://localhost:8095
# LIBRECHAT_CODE_API_KEY=your-secret-api-key-here
