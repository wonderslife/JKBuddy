# Code Command API Server
# This Dockerfile is for the API server that manages code execution
# The sandbox containers use the main Dockerfile

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY code_interpreter.py .
COPY shared_assets/ ./shared_assets/

# Create data directory
# Note: Running as root to access Docker socket for spawning sandbox containers
# The sandboxed code runs in isolated containers with non-root user
RUN mkdir -p /data/workspaces

EXPOSE 8095

CMD ["python", "code_interpreter.py", "--host", "0.0.0.0", "--port", "8095"]
